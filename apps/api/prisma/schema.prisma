// Modelo persistente. Regla de arquitectura (sección 8/12): NUNCA se guardan
// fotos en Postgres — solo claves de objeto en S3 y su fecha de expiración.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum GarmentCategory {
  top
  bottom
  dress
  outerwear
  footwear
  accessory
}

enum Stretch {
  none
  low
  medium
  high
}

enum TryOnMode {
  similar_model
  live_overlay
  photorealistic
}

enum GenerationStatus {
  idle
  queued
  processing
  done
  failed
  fallback
}

enum FitFeeling {
  runs_small
  true_to_size
  runs_large
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  role              Role           @default(user)
  /// Consentimiento separado para reentrenar modelos (sección 8.4). Nunca true por defecto.
  retrainingConsent Boolean        @default(false)
  createdAt         DateTime       @default(now())
  sessions          TryOnSession[]
  reviews           FitReview[]
  profile           BodyProfile?
  favorites         FavoriteOutfit[]
}

/// Perfil corporal guardado por decisión explícita de la persona (ADR 0004). Sin consentimiento no
/// existe; quitarlo o borrar la cuenta borra la fila y la foto. Fuera de aquí las medidas no se guardan.
model BodyProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm   Float
  weightKg   Float?
  chestCm    Float?
  waistCm    Float?
  hipCm      Float?
  shoulderCm Float?
  /// Medidas que estimó la IA (las escritas por la persona las reemplazan y salen de aquí).
  aiFields   String[] @default([])
  /// Clave en el almacenamiento, fuera de `uploads/` para que no la borre el TTL de 24 h.
  photoKey   String?
  consentAt  DateTime
  updatedAt  DateTime @updatedAt
}

/// Conjunto guardado en "Mis favoritos": la imagen probada con IA y las prendas con su talla.
/// Es de la cuenta (como un resultado guardado): no lo toca el TTL; borrar la cuenta lo borra.
model FavoriteOutfit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  /// Quién lo lleva (p. ej. "Él", "Ella"): una cuenta puede probar para su familia.
  wearer      String?
  /// Modelo de cuerpo usado, si no fue una foto propia.
  bodyModelId String?
  /// Clave en el almacenamiento, bajo saved/ (fuera del TTL de 24 h).
  imageKey    String
  /// [{ garmentId, size, recommendedSize? }]
  items       Json
  /// Lo que muestra la prueba (p. ej. "talla L sobre una M: queda holgada").
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Brand {
  id           String             @id @default(uuid())
  name         String             @unique
  garments     Garment[]
  calibrations BrandCalibration[]
}

model Garment {
  id               String            @id @default(uuid())
  name             String
  brandId          String
  brand            Brand             @relation(fields: [brandId], references: [id])
  category         GarmentCategory
  /// Tipo de prenda (tshirt, jeans, dress-a...): decide el patronaje de las tallas.
  style            String
  color            String
  priceCents       Int
  /// Foto real de producto: la única imagen de la prenda en la tienda.
  photoKey         String
  /// Cómo está fotografiada: sola (flat-lay), puesta en una persona (model) o extraída de una foto con persona (extracted).
  photoType        String            @default("flat-lay")
  /// Recorte con transparencia para la cámara en vivo; sin él la prenda no la ofrece.
  cutoutKey        String?
  /// Miniatura WebP de la foto de tienda para listados (srcset).
  thumbKey         String?
  /// Anclas medidas en el recorte (cuello, hombros, puños, cintura, rodillas…): ver GarmentAnchors.
  overlayAnchors   Json?
  /// Holgura de diseño { chestEaseCm, waistEaseCm, hipEaseCm }.
  fitIntent        Json?
  fabricNotes      String?
  stretch          Stretch           @default(low)
  knownLimitations String[]          @default([])
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  sizeChart        SizeChartEntry[]
  previews         BodyModelPreview[]
  reviews          FitReview[]
  sessions         TryOnSession[]
}

model SizeChartEntry {
  id        String  @id @default(uuid())
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size      String
  sortOrder Int
  chestMin  Float?
  chestMax  Float?
  waistMin  Float?
  waistMax  Float?
  hipMin    Float?
  hipMax    Float?
  heightMin Float?
  heightMax Float?
  /// Medidas de la PRENDA en esta talla (no del cuerpo), en cm.
  gChest    Float?
  gWaist    Float?
  gHip      Float?
  gLength   Float?
  gSleeve   Float?
  gInseam   Float?

  @@unique([garmentId, size])
}

/// Catálogo "cuerpo similar al mío" — obligatorio y diverso desde el día uno (sección 4, regla 4).
model BodyModel {
  id          String             @id @default(uuid())
  bodyTypeTag String
  typicalSize String
  heightMin   Int
  heightMax   Int
  skinTone    String
  /// Medidas de referencia (hombro, pecho, cintura, cadera, altura) en cm.
  shape       Json
  /// Foto real de una persona con esta complexión (banco con licencia libre).
  photoKey    String
  /// Puntos de pose de la foto (BlazePose, normalizados): para vestir la prenda al instante sin IA.
  pose        Json?
  /// En la foto lleva una prenda de una pieza (vestido): la IA no le cambia solo la parte de arriba o de abajo.
  onePiece    Boolean            @default(false)
  /// En la foto tiene las manos en los bolsillos: la IA no le cambia la parte de abajo.
  handsInPockets Boolean         @default(false)
  sortOrder   Int                @default(0)
  previews    BodyModelPreview[]
}

model BodyModelPreview {
  bodyModelId String
  bodyModel   BodyModel @relation(fields: [bodyModelId], references: [id], onDelete: Cascade)
  garmentId   String
  garment     Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  /// Prueba real generada por el motor de IA: esta prenda sobre la foto de este modelo.
  imageKey    String

  @@id([bodyModelId, garmentId])
}

model TryOnSession {
  id                String           @id @default(uuid())
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identificador anónimo de navegador: las sesiones sin cuenta son válidas.
  ownerSid          String
  garmentId         String
  garment           Garment          @relation(fields: [garmentId], references: [id])
  mode              TryOnMode
  bodyModelId       String?
  photoKey          String?
  photoExpiresAt    DateTime?
  resultKey         String?
  resultSaved       Boolean          @default(false)
  generationStatus  GenerationStatus @default(idle)
  /// Última transición de estado: el reaper la usa para detectar generaciones atascadas.
  statusChangedAt   DateTime         @default(now())
  failureReason     String?
  fitRecommendation Json?
  /// Conjunto a probar: [{ garmentId, size }]. Nunca incluye estatura ni peso.
  outfit            Json?
  createdAt         DateTime         @default(now())

  @@index([ownerSid])
  @@index([photoExpiresAt])
  @@index([generationStatus, statusChangedAt])
}

model FitReview {
  id         String     @id @default(uuid())
  garmentId  String
  garment    Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sizeBought String
  feeling    FitFeeling
  zones      String[]
  comment    String?
  createdAt  DateTime   @default(now())

  @@index([garmentId])
}

model BrandCalibration {
  brandId    String
  brand      Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category   GarmentCategory
  sampleSize Int             @default(0)
  shiftSum   Int             @default(0)

  @@id([brandId, category])
}

/// Configuración de IA de la tienda (una sola fila, id = "default").
/// La clave se guarda cifrada con AES-256-GCM; nunca se devuelve completa.
model AiSettings {
  id           String   @id @default("default")
  provider     String   @default("mock")
  model        String?
  encryptedKey String?
  keyLast4     String?
  lastTestOk   Boolean?
  updatedAt    DateTime @updatedAt
}

/// Métricas de la sección 14. No hay (ni debe haber) métrica de "tiempo mirando el propio cuerpo".
model MetricEvent {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
