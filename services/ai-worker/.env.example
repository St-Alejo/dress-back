# Copia a services/ai-worker/.env (ignorado por git) para correr el worker fuera de Docker.
WORKER_TOKEN=
DEFAULT_PROVIDER=mock
MOCK_DELAY_SECONDS=4
# Token gratuito de Hugging Face (tipo read): motor de prueba virtual en Spaces
HF_TOKEN=
# FASHN en una GPU propia (services/gpu-tryon), sin cuota. Vacío = solo Spaces de Hugging Face.
LOCAL_TRYON_URL=
# Groq: control de calidad de la foto y etiquetado de prendas (no genera imagenes)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Claude (opcional, de pago): VISION_PROVIDER=claude lo usa primero y cae a Groq si falla o no tiene saldo
VISION_PROVIDER=groq
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-haiku-5-5
# OpenAI (opcional, de pago): VISION_PROVIDER=openai la usa primero (cae a Groq) y estima medidas para la talla.
# OPENAI_BUDGET_USD corta las llamadas al llegar a ese gasto acumulado (se guarda en OPENAI_SPEND_FILE).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_BUDGET_USD=0.20
OPENAI_SPEND_FILE=.openai-spend.json
# Acabado con IA de imagen (POST /v1/finish): realismo de la tela, talla elegida y zapatos (~0,017 USD por conjunto).
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
