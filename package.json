{
  "name": "vestirse-api",
  "private": true,
  "version": "0.1.0",
  "description": "Back del probador de ropa virtual Vestirse: API NestJS, ai-worker FastAPI y motor de tallas (el front vive en el repo dress).",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "build:packages": "npm run build -w packages/shared-types -w packages/fit-engine",
    "dev:api": "npm run start:dev -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "test": "npm test --workspaces --if-present",
    "test:invariants": "npm run test:invariants --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
